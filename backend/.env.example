PORT=3000
# Separate runtime (non-owner, no BYPASSRLS) and migration credentials.
DATABASE_URL=postgresql://erp_app:LOCAL_PASSWORD@127.0.0.1:5432/erp
MIGRATION_DATABASE_URL=postgresql://postgres:LOCAL_ADMIN_PASSWORD@127.0.0.1:5432/erp
APP_DB_PASSWORD=
# Inject securely for bootstrap; never commit real values.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_COMPANY=Mi empresa
BOOTSTRAP_RIF=

# Development sample catalogue only; never receives stock automatically.
SEED_NICOPHARMA_EXAMPLE=true

# Gemini vision is the default document reader. Set a private key from Google AI Studio.
INVOICE_READER_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
